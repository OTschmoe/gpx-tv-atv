<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.gpxtv"
       name="GPX TV"
       version="0.1.0"
       provider-name="Owen">

    <requires>
        <import addon="xbmc.python" version="2.19.0"/>
    </requires>

    <extension point="xbmc.python.script"
               library="default.py">
        <provides>executable</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en">GPX TV</summary>
        <description lang="en">Retro dashboard and media display for Apple TV</description>
        <platform>all</platform>
    </extension>

</addon>